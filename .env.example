# Токен бота, полученный у @BotFather в Telegram
BOT_TOKEN=

# Путь к файлу SQLite-базы (относительный или абсолютный)
DB_PATH=quizbot.sqlite3

# Никакого фонового расписания нет — парсинг всех сайтов запускается лениво,
# при первом же обращении к боту (/today, /week, /post_today) после того,
# как предыдущие данные "протухли". Это значение — на сколько минут
# результат последнего парсинга считается свежим: в течение этого окна
# повторные обращения к боту просто читают уже собранное, ни один сайт
# заново не дёргается.
PARSE_INTERVAL_MINUTES=60

# Город по умолчанию для фильтрации
DEFAULT_CITY=Астана

# Сколько парсеров запускать одновременно (часть из них поднимает
# настоящий браузер через Playwright — на слабой машине/ноутбуке
# не стоит ставить сильно больше 4-5, иначе браузеры начнут конкурировать
# за CPU/RAM и часть парсеров будет падать по таймауту)
MAX_CONCURRENT_PARSERS=4

# Настройки постинга опроса с расписанием на сегодня в канал (команда
# /post_today). Без них команда недоступна.
#
# ADMIN_USER_ID — числовые Telegram ID администраторов (кому разрешено
# вызывать /post_today и добавлять квизы вручную). Можно указать несколько
# через запятую: ADMIN_USER_ID=111111111,222222222. Узнать свой ID можно,
# написав боту @userinfobot.
ADMIN_USER_ID=

# CHANNEL_ID — канал, куда бот будет постить опрос. Бота нужно сначала
# добавить в канал как администратора с правом публиковать сообщения.
# Можно указать публичный юзернейм канала (@my_quiz_channel) или числовой
# ID канала (обычно начинается с -100..., его можно узнать, например,
# переслав любое сообщение из канала боту @getidsbot).
CHANNEL_ID=
